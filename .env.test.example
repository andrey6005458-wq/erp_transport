# .env.test.example
#
# Шаблон тестовых переменных. Скопируй в .env.test и подставь пароль.
# .env.test не коммитится (см. .gitignore).
#
# ВАЖНО: порт 5433 и БД erp_transport_test — из docker-compose.test.yml.
# Эти переменные использует:
#   1) docker compose -f docker-compose.test.yml --env-file .env.test
#   2) pytest (через conftest.py, чтобы собрать TEST_DATABASE_URL)

# Приложение
APP_NAME=ERP Transport
APP_ENV=test
DEBUG=True
SECRET_KEY=test_secret_not_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL (тестовая БД)
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=erp_transport_test
